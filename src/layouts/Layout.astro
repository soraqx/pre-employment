---
import ogImage from '../assets/og-image.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'dochi guide',
  description = 'A warm and friendly pre-employment guide for your next opportunity.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F5DC" />
    <meta property="og:image" content={ogImage.src} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content="dochi guide — a friendly pre-employment guide" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-[#F5F5DC] text-[#242424]">
    <header class="sticky top-0 z-40 border-b border-black/10 bg-[#FFF8DC]/90 backdrop-blur-lg">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4"
        aria-label="Main navigation"
      >
        <a href="/" class="group flex items-center gap-3 text-xl font-extrabold tracking-tight text-[#1f1f1f]">
          <span class="grid size-10 place-items-center rounded-full bg-black text-[#FFF8DC] transition-transform group-hover:-rotate-6" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-6 fill-current" role="img">
              <path d="M5.2 9.1 4.4 4.3l4.1 2.2A8.2 8.2 0 0 1 12 5.7c1.2 0 2.4.3 3.5.8l4.1-2.2-.8 4.8a7.7 7.7 0 0 1 1.4 4.4c0 4.3-3.7 7.5-8.2 7.5s-8.2-3.2-8.2-7.5c0-1.6.5-3.1 1.4-4.4Z" />
            </svg>
          </span>
          dochi guide
        </a>

        <div class="flex items-center gap-1 sm:gap-3">
          <a href="/" class="rounded-full px-3 py-2 text-sm font-bold transition hover:bg-black hover:text-[#FFF8DC]">Home</a>
          <a href="/#chapters" class="rounded-full px-3 py-2 text-sm font-bold transition hover:bg-black hover:text-[#FFF8DC]">Guide</a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-black/10 bg-[#FFF8DC]">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-5 py-8 text-center text-sm text-[#3a3a3a] sm:flex-row sm:justify-between sm:text-left">
        <p class="font-bold">dochi says: one brave little step at a time.</p>
        <p class="flex items-center gap-2" aria-label="Made with care and cat paws">
          Made with care <span aria-hidden="true">&#x1F43E;</span>
        </p>
      </div>
    </footer>
  </body>
</html>
