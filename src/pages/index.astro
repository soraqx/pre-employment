---
import { getCollection } from 'astro:content';
import CheeringDochiCard from '../components/CheeringDochiCard.astro';
import PopupInfo from '../components/PopupInfo';
import Layout from '../layouts/Layout.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-20 pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:pt-24">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-black/10 bg-[#FFF8DC] px-4 py-2 text-sm font-extrabold">
        <span aria-hidden="true">&#x1F43E;</span>
        A cozy corner for getting career-ready
      </p>
      <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.04] tracking-tight text-[#1f1f1f] sm:text-7xl">
        Hello, future
        <span class="relative inline-block">
          you.
          <svg class="absolute -bottom-2 left-0 h-3 w-full text-black/20" viewBox="0 0 180 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 8c42-7 95 5 176-4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          </svg>
        </span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#454545]">
        Welcome to <strong>dochi guide</strong>, a gentle and practical companion for your pre-employment prep !! :33.
      </p>
      <div class="mt-9">
        <PopupInfo client:idle title="A tip from dochi" buttonLabel="Tap the paw for a tip">
          Check mo nalang guides here!! I'll also be updating this based on what I've experienced thru each process.
        </PopupInfo>
      </div>
    </div>

    <CheeringDochiCard />
  </section>

  <section id="chapters" class="mx-auto max-w-6xl scroll-mt-28 px-5">
    <div class="mb-8">
      <p class="font-extrabold uppercase tracking-[0.18em] text-black/50">Explore the guide</p>
      <h2 class="mt-2 text-3xl font-extrabold text-[#1f1f1f] sm:text-4xl">Take it chapter by chapter</h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((guide) => (
        <a
          href={`/guide/${guide.id}/`}
          class="group rounded-3xl border border-black/10 bg-[#FFF8DC] p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_45px_rgba(0,0,0,0.10)]"
        >
          <div class="flex items-start justify-between">
            <span class="text-3xl" aria-hidden="true">{guide.data.icon}</span>
            <span class="text-lg opacity-30 transition group-hover:rotate-12 group-hover:opacity-70" aria-hidden="true">&#x1F43E;</span>
          </div>
          <h3 class="mt-4 text-xl font-extrabold text-[#242424]">{guide.data.title}</h3>
          <p class="mt-2 leading-7 text-[#555]">{guide.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
