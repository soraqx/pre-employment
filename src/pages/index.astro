---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PopupInfo from '../components/PopupInfo';

const chapters = (await getCollection('chapters', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <section class="mx-auto grid max-w-6xl gap-10 px-5 pb-20 pt-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:pt-28">
    <div>
      <p class="mb-4 inline-flex rounded-full bg-beige-100 px-4 py-2 text-sm font-extrabold text-cocoa-600">A gentler way to get job-ready ✨</p>
      <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.05] tracking-tight text-cocoa-700 sm:text-7xl">Your next step starts here.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-cocoa-600">Practical, encouraging guidance for every part of your pre-employment journey—from preparation to interview day.</p>
      <div class="mt-8">
        <PopupInfo client:idle title="Before you begin" buttonLabel="Give me a quick tip">
          Pick just one chapter for today. Small, focused progress is easier to repeat—and repeating it is how confidence grows.
        </PopupInfo>
      </div>
    </div>
    <div class="mx-auto grid aspect-square w-full max-w-md place-items-center rounded-[3rem] border border-beige-200 bg-cream-100 p-10 shadow-soft">
      <span class="text-9xl" aria-label="A sprouting plant">🌱</span>
    </div>
  </section>

  <section id="chapters" class="mx-auto max-w-6xl scroll-mt-28 px-5">
    <div class="mb-8">
      <p class="font-extrabold uppercase tracking-[0.18em] text-cocoa-400">The guide</p>
      <h2 class="mt-2 text-3xl font-extrabold text-cocoa-700 sm:text-4xl">Take it chapter by chapter</h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {chapters.map((chapter) => (
        <a href={`/guide/${chapter.id}/`} class="group rounded-3xl border border-beige-200 bg-cream-50 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-soft">
          <span class="text-3xl" aria-hidden="true">{chapter.data.emoji}</span>
          <h3 class="mt-4 text-xl font-extrabold text-cocoa-700 group-hover:text-cocoa-500">{chapter.data.title}</h3>
          <p class="mt-2 leading-7 text-cocoa-600">{chapter.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
